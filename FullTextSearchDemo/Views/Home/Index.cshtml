@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Full Text Search Demo</h1>
    <p>This application demonstrates different search techniques using ASP.NET Core MVC and PostgreSQL.</p>
    
    <div class="mt-5">
        <a href="@Url.Action("Search", "Home")" class="btn btn-primary btn-lg">Go to Search</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Basic Search</h5>
            </div>
            <div class="card-body">
                <p>Simple text search using LIKE/Contains operators.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Full-Text Search</h5>
            </div>
            <div class="card-body">
                <p>Advanced search using PostgreSQL's full-text search capabilities.</p>
            </div>
        </div>
    </div>
</div>
