@{
    ViewData["Title"] = "ค้นหา";
}

<style>
    yellow {
        background-color: yellow;
        color: black;
        font-weight: bold;
        padding: 2px 4px;
        border-radius: 3px;
    }
</style>

@section Scripts {
    <script>
        // Call the GetBlogs API endpoint when the page loads
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/api/blogs-thai')
                .then(response => response.json())
                .then(data => {
                    displayBlogs(data);
                })
                .catch(error => {
                    console.error('Error fetching blogs:', error);
                });

            // Client-side validation and API call handling
            document.querySelector('form').addEventListener('submit', function (e) {
                e.preventDefault(); // Prevent the default form submission

                const searchTerm = document.querySelector('input[name="searchTerm"]').value;
                if (!searchTerm.trim()) {
                    alert('กรุณาใส่คำค้นหา');
                    return;
                }

                const searchType = document.querySelector('input[name="searchType"]:checked').value;

                // Determine which API endpoint to call based on the search type
                let apiUrl = '';
                if (searchType === 'basic') {
                    apiUrl = `/api/blogs-thai/contains/normalized?searchTerm=${encodeURIComponent(searchTerm)}`;
                } else if (searchType === 'fulltext') {
                    apiUrl = `/api/blogs-thai/full-text/ranking?searchTerm=${encodeURIComponent(searchTerm)}`;
                } else if (searchType === 'fulltext-highlight') {
                    apiUrl = `/api/blogs-thai/full-text/highlight?searchTerm=${encodeURIComponent(searchTerm)}`;
                }

                // Show loading state
                const resultsContainer = document.getElementById('allBlogsContainer');
                resultsContainer.innerHTML = `
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลด...</span>
                            </div>
                            <p class="mt-2">กำลังค้นหา "${searchTerm}"...</p>
                        </div>
                    `;

                // Call the API
                fetch(apiUrl)
                    .then(response => response.json())
                    .then(data => {
                        displaySearchResults(data, searchTerm);
                    })
                    .catch(error => {
                        console.error('Error searching blogs:', error);
                        resultsContainer.innerHTML = `<div class="alert alert-danger">เกิดข้อผิดพลาดในการค้นหาบทความ: ${error.message}</div>`;
                    });
            });
        });

        function displayBlogs(blogs) {
            const resultsContainer = document.getElementById('allBlogsContainer');

            if (!blogs || blogs.length === 0) {
                resultsContainer.innerHTML = '<div class="alert alert-info">ไม่พบบทความ</div>';
                return;
            }

            let html = '';
            html += `
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">Slug</th>
                                        <th scope="col">วันที่</th>
                                        <th scope="col">ย่อหน้า</th>
                                        <th scope="col">หน้า</th>
                                        <th scope="col">หัวข้อ</th>
                                        <th scope="col">เนื้อหา</th>
                                        <th scope="col">บทคัดย่อ</th>
                                    </tr>
                                </thead>
                                <tbody>
                        `;
            blogs.forEach(blog => {
                html += `
                                <tr>
                                 <td>${blog.slug}</td>
                                  <td>${blog.date}</td>
                                  <td>${blog.position}</td>
                                  <td>${blog.page}</td>
                                   <td>${blog.title}</td>
                                   <td>${blog.content}</td>
                                   <td>${blog.excerpt}</td>
                                </tr>
                            `;
            });
            html += `
                                </tbody>
                            </table>
                        `;

            resultsContainer.innerHTML = html;
        }

        function displaySearchResults(blogs, searchTerm) {
            const resultsContainer = document.getElementById('allBlogsContainer');

            if (!blogs || blogs.length === 0) {
                resultsContainer.innerHTML = `<div class="alert alert-info">ไม่พบผลลัพธ์สำหรับ "${searchTerm}"</div>`;
                return;
            }

            let html = '';
            html += `
                    <h3>ผลการค้นหาสำหรับ "${searchTerm}"</h3>
                    <p>พบ ${blogs.length} ผลลัพธ์</p>
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Slug</th>
                                <th scope="col">วันที่</th>
                                <th scope="col">ย่อหน้า</th>
                                <th scope="col">หน้า</th>
                                <th scope="col">หัวข้อ</th>
                                <th scope="col">เนื้อหา</th>
                                <th scope="col">บทคัดย่อ</th>
                                ${blogs[0].hasOwnProperty('rank') ? '<th scope="col">คะแนนความเกี่ยวข้อง</th>' : ''}
                                ${blogs[0].hasOwnProperty('highlight') ? '<th scope="col">เนื้อหาที่ไฮไลท์</th>' : ''}
                            </tr>
                        </thead>
                        <tbody>
                `;

            blogs.forEach(blog => {
                html += `
                        <tr>
                            <td>${blog.hasOwnProperty('highlightSlug') ? blog.highlightSlug : blog.slug}</td>
                            <td>${blog.date}</td>
                            <td>${blog.position}</td>
                            <td>${blog.page}</td>
                            <td>${blog.hasOwnProperty('highlightTitle') ? blog.highlightTitle : blog.title}</td>
                            <td>${blog.hasOwnProperty('highlightContent') ? blog.highlightContent : blog.content}</td>
                            <td>${blog.hasOwnProperty('highlightExcerpt') ? blog.highlightExcerpt : blog.excerpt}</td>
                            ${blog.hasOwnProperty('rank') ? `<td>${blog.rank.toFixed(2)}</td>` : ''}
                            ${blog.hasOwnProperty('highlight') ? `<td>${blog.highlight}</td>` : ''}
                        </tr>
                    `;
            });

            html += `
                        </tbody>
                    </table>
                `;

            resultsContainer.innerHTML = html;
        }
    </script>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-end mb-3">
                <a href="/Home/Search" class="btn btn-outline-primary">English</a>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="search-container">
                <h1 class="mb-4">ค้นหาบทความ</h1>

                <form class="mb-4">
                    <div class="search-box mb-3">
                        <input type="text" class="form-control" name="searchTerm" placeholder="ค้นหาบทความ..." required>
                        <button class="btn btn-search" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="basicSearch"
                                value="basic" checked>
                            <label class="form-check-label" for="basicSearch">
                                ค้นหาพื้นฐาน
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="fullTextSearch"
                                value="fulltext">
                            <label class="form-check-label" for="fullTextSearch">
                                ค้นหาแบบ Full-Text
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="fullTextHighlight"
                                value="fulltext-highlight">
                            <label class="form-check-label" for="fullTextHighlight">
                                ค้นหาพร้อมไฮไลท์
                            </label>
                        </div>
                    </div>
                </form>

                <div class="search-tips bg-light p-3 rounded">
                    <h5 class="mb-2"><i class="bi bi-lightbulb me-2"></i>เคล็ดลับการค้นหา</h5>
                    <ul class="mb-0">
                        <li>ใช้คำค้นหาที่เฉพาะเจาะจงเพื่อผลลัพธ์ที่ดีขึ้น</li>
                        <li>การค้นหาแบบ Full-text ทำงานได้ดีกับคำถามภาษาธรรมชาติ</li>
                        <li>ลองใช้การค้นหาพร้อมไฮไลท์เพื่อดูว่าคำค้นหาของคุณปรากฏที่ใด</li>
                    </ul>
                </div>

                <div class="mt-5">
                    <h2 class="mb-4">บทความทั้งหมด</h2>
                    <div id="allBlogsContainer" class="results-container">
                        <!-- Blog posts will be loaded here via JavaScript -->
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">กำลังโหลด...</span>
                            </div>
                            <p class="mt-2">กำลังโหลดบทความ...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
