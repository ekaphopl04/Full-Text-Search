@{
    ViewData["Title"] = "Search";
}

<style>
    yellow {
        background-color: yellow;
        color: black;
        font-weight: bold;
        padding: 2px 4px;
        border-radius: 3px;
    }
</style>

@section Scripts {
    <script>
        // Call the GetBlogs API endpoint when the page loads
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/api/blogs')
                .then(response => response.json())
                .then(data => {
                    displayBlogs(data);
                })
                .catch(error => {
                    console.error('Error fetching blogs:', error);
                });

            // Client-side validation and API call handling
            document.querySelector('form').addEventListener('submit', function (e) {
                e.preventDefault(); // Prevent the default form submission
                
                const searchTerm = document.querySelector('input[name="searchTerm"]').value;
                if (!searchTerm.trim()) {
                    alert('Please enter a search term');
                    return;
                }
                
                const searchType = document.querySelector('input[name="searchType"]:checked').value;
                
                // Determine which API endpoint to call based on the search type
                let apiUrl = '';
                if (searchType === 'basic') {
                    apiUrl = `/api/blogs/contains/normalized?searchTerm=${encodeURIComponent(searchTerm)}`;
                } else if (searchType === 'fulltext') {
                    apiUrl = `/api/blogs/full-text/ranking?searchTerm=${encodeURIComponent(searchTerm)}`;
                }  else if (searchType === 'fulltext-highlight') {
                    apiUrl = `/api/blogs/full-text/highlight?searchTerm=${encodeURIComponent(searchTerm)}`;
                }
                
                // Show loading state
                const resultsContainer = document.getElementById('allBlogsContainer');
                resultsContainer.innerHTML = `
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Searching for "${searchTerm}"...</p>
                    </div>
                `;
                
                // Call the API
                fetch(apiUrl)
                    .then(response => response.json())
                    .then(data => {
                        displaySearchResults(data, searchTerm);
                    })
                    .catch(error => {
                        console.error('Error searching blogs:', error);
                        resultsContainer.innerHTML = `<div class="alert alert-danger">Error searching blogs: ${error.message}</div>`;
                    });
            });
        });

        function displayBlogs(blogs) {
            const resultsContainer = document.getElementById('allBlogsContainer');

            if (!blogs || blogs.length === 0) {
                resultsContainer.innerHTML = '<div class="alert alert-info">No blogs found</div>';
                return;
            }

            let html = '';
            html += `
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">Slug</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Content</th>
                                    <th scope="col">Excerpt</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;
            blogs.forEach(blog => {
                html += `
                            <tr>
                             <td>${blog.slug}</td>
                              <td>${blog.date}</td>
                               <td>${blog.title}</td>
                               <td>${blog.content}</td>
                               <td>${blog.excerpt}</td>
                            </tr>
                        `;
            });
            html += `
                            </tbody>
                        </table>
                    `;

            resultsContainer.innerHTML = html;
        }
        
        function displaySearchResults(blogs, searchTerm) {
            const resultsContainer = document.getElementById('allBlogsContainer');

            if (!blogs || blogs.length === 0) {
                resultsContainer.innerHTML = `<div class="alert alert-info">No results found for "${searchTerm}"</div>`;
                return;
            }

            let html = '';
            html += `
                <h3>Search Results for "${searchTerm}"</h3>
                <p>Found ${blogs.length} result(s)</p>
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Slug</th>
                            <th scope="col">Date</th>
                            <th scope="col">Title</th>
                            <th scope="col">Content</th>
                            <th scope="col">Excerpt</th>
                            ${blogs[0].hasOwnProperty('rank') ? '<th scope="col">Relevance Score</th>' : ''}
                            ${blogs[0].hasOwnProperty('highlight') ? '<th scope="col">Highlighted Content</th>' : ''}
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            blogs.forEach(blog => {
                html += `
                    <tr>
                        <td>${blog.hasOwnProperty('highlightSlug') ? blog.highlightSlug : blog.slug}</td>
                        <td>${blog.date}</td>
                        <td>${blog.hasOwnProperty('highlightTitle') ? blog.highlightTitle : blog.title}</td>
                        <td>${blog.hasOwnProperty('highlightContent') ? blog.highlightContent : blog.content}</td>
                        <td>${blog.hasOwnProperty('highlightExcerpt') ? blog.highlightExcerpt : blog.excerpt}</td>
                        ${blog.hasOwnProperty('rank') ? `<td>${blog.rank.toFixed(2)}</td>` : ''}
                        ${blog.hasOwnProperty('highlight') ? `<td>${blog.highlight}</td>` : ''}
                    </tr>
                `;
            });
            
            html += `
                    </tbody>
                </table>
            `;

            resultsContainer.innerHTML = html;
        }
    </script>
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="search-container">
                <h1 class="mb-4">Search Articles</h1>

                <form class="mb-4">
                    <div class="search-box mb-3">
                        <input type="text" class="form-control" name="searchTerm" placeholder="Search articles..."
                            required>
                        <button class="btn btn-search" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="basicSearch"
                                value="basic" checked>
                            <label class="form-check-label" for="basicSearch">
                                Basic Search
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="fullTextSearch"
                                value="fulltext">
                            <label class="form-check-label" for="fullTextSearch">
                                Full-Text Search
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchType" id="fullTextHighlight"
                                value="fulltext-highlight">
                            <label class="form-check-label" for="fullTextHighlight">
                                Highlighted Search
                            </label>
                        </div>
                    </div>
                </form>

                <div class="search-tips bg-light p-3 rounded">
                    <h5 class="mb-2"><i class="bi bi-lightbulb me-2"></i>Search Tips</h5>
                    <ul class="mb-0">
                        <li>Use specific keywords for better results</li>
                        <li>Full-text search works better with natural language queries</li>
                        <li>Try the highlighted search to see where your terms appear</li>
                    </ul>
                </div>

                <div class="mt-5">
                    <h2 class="mb-4">All Articles</h2>
                    <div id="allBlogsContainer" class="results-container">
                        <!-- Blog posts will be loaded here via JavaScript -->
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading articles...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
