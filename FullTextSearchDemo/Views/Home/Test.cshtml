@model dynamic

<div class="container-fluid py-5 bg-light">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-primary">Search Comparison Tool</h1>
                <p class="lead text-muted">Compare basic search vs full-text search performance and results</p>
                <hr class="my-4 w-25 mx-auto">
            </div>

            @if (TempData["SubmittedData"] != null)
            {
                <div class="alert alert-success shadow-sm border-0 rounded-3 animate__animated animate__fadeIn">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success me-2 fs-4"></i>
                        <h4 class="mb-0">Search Results</h4>
                    </div>
                    <hr>
                    <pre class="bg-light p-3 rounded">@TempData["SubmittedData"]</pre>
                </div>
            }

            <div class="card shadow border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-search me-2 fs-4"></i>
                        <h4 class="mb-0">Advanced Search Options</h4>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Home" asp-action="TestSubmit" method="post" class="needs-validation" novalidate>
                        <div class="form-group mb-4">
                            <label for="searchTerm" class="form-label fw-bold">
                                <i class="bi bi-text-paragraph me-2"></i>Search Term:
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" 
                                       class="form-control form-control-lg shadow-none border-start-0" 
                                       id="searchTerm" 
                                       name="searchTerm" 
                                       placeholder="Enter keywords to search..." 
                                       required>
                                <div class="invalid-feedback">
                                    Please enter a search term
                                </div>
                            </div>
                            <small class="text-muted mt-1">Try searching for specific keywords or phrases</small>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-gear me-2"></i>Search Method:
                            </label>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <div class="card h-100 border-primary search-option">
                                        <div class="card-body p-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="searchType" id="basicSearch" value="basic" checked>
                                                <label class="form-check-label w-100" for="basicSearch">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold">Basic Search</span>
                                                        <i class="bi bi-search fs-4 text-primary"></i>
                                                    </div>
                                                    <p class="text-muted small mb-0 mt-2">Standard database query using LIKE operator</p>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100 border-success search-option">
                                        <div class="card-body p-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="searchType" id="fulltextSearch" value="fulltext">
                                                <label class="form-check-label w-100" for="fulltextSearch">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold">Full-Text Search</span>
                                                        <i class="bi bi-lightning-charge fs-4 text-success"></i>
                                                    </div>
                                                    <p class="text-muted small mb-0 mt-2">Advanced indexing for faster and more relevant results</p>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search me-2"></i>Run Search Test
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    This tool helps compare different search methods and their performance
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
        
        // Highlight search option cards on selection
        document.querySelectorAll('.search-option').forEach(card => {
            card.addEventListener('click', function() {
                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;
                
                document.querySelectorAll('.search-option').forEach(c => {
                    c.classList.remove('bg-light');
                });
                this.classList.add('bg-light');
            });
        });
        
        // Initialize with the checked option highlighted
        document.addEventListener('DOMContentLoaded', function() {
            const checkedOption = document.querySelector('input[type="radio"]:checked');
            if (checkedOption) {
                checkedOption.closest('.search-option').classList.add('bg-light');
            }
        });
    </script>
}